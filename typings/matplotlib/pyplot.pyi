# Local typed subset exercised by the workbook CLI and plotting tests.
#
# Signatures are deliberately limited to the calls this project uses; values
# returned only for display are opaque. No catch-all kwargs or dynamic members.
from os import PathLike

from numpy.typing import ArrayLike

class Figure:
    def tight_layout(self) -> None: ...
    def savefig(self, fname: str | PathLike[str]) -> None: ...

class Axes:
    def barh(self, y: ArrayLike, width: ArrayLike) -> object: ...
    def hist(self, x: ArrayLike) -> object: ...
    def set_xlabel(self, xlabel: str) -> object: ...

def figure(*, figsize: tuple[float, float]) -> Figure: ...
def subplots(*, figsize: tuple[float, float] | None = ...) -> tuple[Figure, Axes]: ...
def barh(y: ArrayLike, width: ArrayLike) -> object: ...
def hist(x: ArrayLike) -> object: ...
def xlabel(xlabel: str) -> object: ...
def ylabel(ylabel: str) -> object: ...
def title(label: str) -> object: ...
def tight_layout() -> None: ...
def savefig(fname: str | PathLike[str]) -> None: ...
def close(fig: Figure | None = ...) -> None: ...
