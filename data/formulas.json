{
  "formulas": [
    {
      "id": "annual_raw_cost",
      "type": "base",
      "description": "Year 0 raw annual cost before productive time adjustment.",
      "expression": "base_salary + base_salary * (super_rate + avg_penalties + pub_holiday_penalty + private_practice_loading + retention_allowance + sick_leave) + professional_development_allowance + base_salary * ((52 + annual_leave_weeks) / 52) * (1 + annual_leave_loading)",
      "parameters": [
        "base_salary",
        "super_rate",
        "avg_penalties",
        "pub_holiday_penalty",
        "private_practice_loading",
        "retention_allowance",
        "professional_development_allowance",
        "sick_leave",
        "annual_leave_weeks",
        "annual_leave_loading"
      ]
    },
    {
      "id": "year_0_total_cost",
      "type": "dependent",
      "description": "Year 0 total cost adjusted by productive time.",
      "dependencies": ["annual_raw_cost"],
      "expression": "annual_raw_cost / productive_time_factor",
      "parameters": ["annual_raw_cost", "productive_time_factor"]
    },
    {
      "id": "hourly_rate",
      "type": "dependent",
      "description": "Year 0 hourly rate from annual total cost.",
      "dependencies": ["year_0_total_cost"],
      "expression": "year_0_total_cost / 52 / hours_per_week",
      "parameters": ["year_0_total_cost", "hours_per_week"]
    }
  ],
  "outputs": [
    {
      "name": "Calculated_Cost_LL",
      "calculation_method": "direct",
      "source_column": "Base Salary + Costs_LL"
    },
    {
      "name": "Calculated_Cost_Mid",
      "calculation_method": "formula",
      "uses_formula": "year_0_total_cost",
      "parameter_mapping": {
        "base_salary": "Base Salary_Mid-point",
        "super_rate": "Grade(s)_Superannuation Rate (%)",
        "avg_penalties": "Grade(s)_Average Penalties %",
        "pub_holiday_penalty": "Grade(s)_Public Holiday Penalty %",
        "private_practice_loading": "Grade(s)_Private Practice Loading %",
        "retention_allowance": "Grade(s)_Attraction and Retention Allowance %",
        "sick_leave": "Grade(s)_Sick Leave %",
        "professional_development_allowance": "Grade(s)_Professional Development Allowance ($)",
        "annual_leave_weeks": "Grade(s)_Annual Leave Entitlement (Weeks)",
        "annual_leave_loading": "Grade(s)_Annual Leave Loading (%)",
        "productive_time_factor": "Grade(s)_Average productive time (%)",
        "hours_per_week": "Grade(s)_Hours per week"
      }
    },
    {
      "name": "Calculated_Cost_UL",
      "calculation_method": "direct",
      "source_column": "Base Salary + Costs_UL"
    }
  ]
}
