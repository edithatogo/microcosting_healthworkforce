{
  "formulas": [
    {
      "id": "base_salary_with_super",
      "type": "base",
      "description": "Calculates the base salary including superannuation.",
      "expression": "base_salary * (1 + super_rate)",
      "parameters": ["base_salary", "super_rate"]
    },
    {
      "id": "total_penalties",
      "type": "base",
      "description": "Calculates the total penalties.",
      "expression": "base_salary * (avg_penalties + pub_holiday_penalty + private_practice_loading)",
      "parameters": [
        "base_salary",
        "avg_penalties",
        "pub_holiday_penalty",
        "private_practice_loading"
      ]
    },
    {
      "id": "total_allowances",
      "type": "base",
      "description": "Calculates the total allowances.",
      "expression": "base_salary * retention_allowance + professional_development_allowance",
      "parameters": [
        "base_salary",
        "retention_allowance",
        "professional_development_allowance"
      ]
    },
    {
      "id": "total_leave_costs",
      "type": "base",
      "description": "Calculates the total leave costs.",
      "expression": "base_salary * sick_leave + ((base_salary * ((52 + annual_leave_weeks) / 52)) * (1 + annual_leave_loading))",
      "parameters": [
        "base_salary",
        "sick_leave",
        "annual_leave_weeks",
        "annual_leave_loading"
      ]
    },
    {
      "id": "year_0_total_cost",
      "type": "dependent",
      "description": "Calculates the total annual cost for a single position.",
      "dependencies": [
        "base_salary_with_super",
        "total_penalties",
        "total_allowances",
        "total_leave_costs"
      ],
      "expression": "(base_salary_with_super + total_penalties + total_allowances + total_leave_costs) / productive_time_factor",
      "parameters": [
        "base_salary_with_super",
        "total_penalties",
        "total_allowances",
        "total_leave_costs",
        "productive_time_factor"
      ]
    }
  ],
  "outputs": [
    {
      "name": "Calculated_Cost_LL",
      "uses_formula": "year_0_total_cost",
      "override_column": "Base Salary + Costs_LL",
      "override_condition": "row['Personnel type'] == 'Override'",
      "parameter_mapping": {
        "base_salary": "Base Salary_LL",
        "super_rate": "Grade(s)_Superannuation Rate (%)",
        "avg_penalties": "Grade(s)_Average Penalties %",
        "pub_holiday_penalty": "Grade(s)_Public Holiday Penalty %",
        "private_practice_loading": "Grade(s)_Private Practice Loading %",
        "retention_allowance": "Grade(s)_Attraction and Retention Allowance %",
        "sick_leave": "Grade(s)_Sick Leave %",
        "professional_development_allowance": "Grade(s)_Professional Development Allowance ($)",
        "annual_leave_weeks": "Grade(s)_Annual Leave Entitlement (Weeks)",
        "annual_leave_loading": "Grade(s)_Annual Leave Loading (%)",
        "productive_time_factor": "Grade(s)_Average productive time (%)"
      }
    },
    {
      "name": "Calculated_Cost_Mid",
      "uses_formula": "year_0_total_cost",
      "override_column": "Base Salary + Costs_Mid-point",
      "override_condition": "row['Personnel type'] == 'Override'",
      "parameter_mapping": {
        "base_salary": "Base Salary_Mid-point",
        "super_rate": "Grade(s)_Superannuation Rate (%)",
        "avg_penalties": "Grade(s)_Average Penalties %",
        "pub_holiday_penalty": "Grade(s)_Public Holiday Penalty %",
        "private_practice_loading": "Grade(s)_Private Practice Loading %",
        "retention_allowance": "Grade(s)_Attraction and Retention Allowance %",
        "sick_leave": "Grade(s)_Sick Leave %",
        "professional_development_allowance": "Grade(s)_Professional Development Allowance ($)",
        "annual_leave_weeks": "Grade(s)_Annual Leave Entitlement (Weeks)",
        "annual_leave_loading": "Grade(s)_Annual Leave Loading (%)",
        "productive_time_factor": "Grade(s)_Average productive time (%)"
      }
    },
    {
      "name": "Calculated_Cost_UL",
      "uses_formula": "year_0_total_cost",
      "override_column": "Base Salary + Costs_UL",
      "override_condition": "row['Personnel type'] == 'Override'",
      "parameter_mapping": {
        "base_salary": "Base Salary_UL",
        "super_rate": "Grade(s)_Superannuation Rate (%)",
        "avg_penalties": "Grade(s)_Average Penalties %",
        "pub_holiday_penalty": "Grade(s)_Public Holiday Penalty %",
        "private_practice_loading": "Grade(s)_Private Practice Loading %",
        "retention_allowance": "Grade(s)_Attraction and Retention Allowance %",
        "sick_leave": "Grade(s)_Sick Leave %",
        "professional_development_allowance": "Grade(s)_Professional Development Allowance ($)",
        "annual_leave_weeks": "Grade(s)_Annual Leave Entitlement (Weeks)",
        "annual_leave_loading": "Grade(s)_Annual Leave Loading (%)",
        "productive_time_factor": "Grade(s)_Average productive time (%)"
      }
    }
  ]
}
